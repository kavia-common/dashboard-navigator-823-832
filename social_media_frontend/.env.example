# Frontend Environment Example for social_media_frontend

# Base URL for API requests (preferred)
REACT_APP_API_BASE=https://api.example.com

# Alternatively, backend base for building API base if API_BASE is not set
REACT_APP_BACKEND_URL=https://backend.example.com

# Frontend app URL (used for auth redirects, etc.)
REACT_APP_FRONTEND_URL=https://app.example.com

# WebSocket URL for real-time features
REACT_APP_WS_URL=wss://ws.example.com

# Runtime/node environment
REACT_APP_NODE_ENV=development

# CRA/Next compatibility flags (kept for parity)
REACT_APP_NEXT_TELEMETRY_DISABLED=1
REACT_APP_ENABLE_SOURCE_MAPS=true

# Local dev server port
REACT_APP_PORT=3000

# Proxy/trust settings
REACT_APP_TRUST_PROXY=false

# Logging level: trace|debug|info|warn|error
REACT_APP_LOG_LEVEL=info

# Healthcheck path the app may expose
REACT_APP_HEALTHCHECK_PATH=/health

# Feature flags (comma-separated or JSON, app-specific)
REACT_APP_FEATURE_FLAGS=

# Experiments toggle
REACT_APP_EXPERIMENTS_ENABLED=false
