# Frontend environment configuration for social_media_frontend
# Copy this file to ".env" and adjust values as needed.

# Core URLs
REACT_APP_API_BASE=http://localhost:4000/api
REACT_APP_BACKEND_URL=http://localhost:4000
REACT_APP_FRONTEND_URL=http://localhost:3000
REACT_APP_WS_URL=ws://localhost:4000

# Environment and build flags
REACT_APP_NODE_ENV=development
REACT_APP_NEXT_TELEMETRY_DISABLED=1
REACT_APP_ENABLE_SOURCE_MAPS=true
REACT_APP_PORT=3000
REACT_APP_TRUST_PROXY=false
REACT_APP_LOG_LEVEL=info

# Health and feature flags
REACT_APP_HEALTHCHECK_PATH=/health
# Comma or JSON string of feature flags, e.g., "featureA=true,featureB=false" or '{"featureA":true}'
REACT_APP_FEATURE_FLAGS=
REACT_APP_EXPERIMENTS_ENABLED=false

# Notes:
# - Only variables prefixed with REACT_APP_ are exposed to the app at runtime (CRA convention).
# - API base resolution order (first non-empty is used):
#   REACT_APP_API_BASE -> REACT_APP_BACKEND_URL + "/api" -> window.location.origin + "/api"
# - Authorization:
#   The API client will use a token from:
#     1) window.__APP_TOKEN__ if present
#     2) localStorage.getItem("auth_token") if present
#   Update storage key if your app uses a different name.
